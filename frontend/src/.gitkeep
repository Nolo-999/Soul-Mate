# 前端占位文件
frontend/
  src/
    main.tsx          # 应用入口
    App.tsx           # 根组件 + 路由
    styles/global.css # 全局样式
    stores/           # Zustand stores
    api/              # Axios API 封装
    pages/            # 页面组件
    components/       # UI 组件
    types/            # TS 类型
    constants/        # 常量
    hooks/            # 自定义 hooks
    utils/            # 工具函数
