# ============================================
# SoulMate Backend 环境变量（复制为 .env 并填入真实值）
# ============================================

# ---- 应用 ----
APP_NAME=SoulMate
DEBUG=true
SECRET_KEY=change-me-in-production
ALLOWED_ORIGINS=http://localhost:3000

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=soulmate

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- 向量库 ----
CHROMA_PERSIS_PATH=./data/chroma

# ---- MinIO ----
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=soulmate

# ---- LLM ----
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_CHAT_MODEL=deepseek-chat
LLM_JSON_MODEL=deepseek-chat

# ---- 语音 STT ----
STT_PROVIDER=volcano
STT_API_KEY=
STT_APP_ID=

# ---- 语音 TTS ----
TTS_PROVIDER=volcano
TTS_API_KEY=
TTS_APP_ID=
TTS_VOICE=

# ---- Celery ----
CELERY_BROKER=redis://127.0.0.1:6379/1
CELERY_BACKEND=redis://127.0.0.1:6379/2
