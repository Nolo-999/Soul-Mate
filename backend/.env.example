# SoulMate 后端环境变量
# 复制此文件为 .env，填入真实值
# ⚠️ .env 已加入 .gitignore，不会提交到仓库

# NVIDIA API（DeepSeek-V4-Pro 抽取 + Embedding 向量化）
SOULMATE_NVIDIA_KEY=

# Milvus 向量库
SOULMATE_MILVUS_HOST=127.0.0.1
SOULMATE_MILVUS_PORT=19530

# Neo4j 图库
SOULMATE_NEO4J_URI=bolt://127.0.0.1:7687
SOULMATE_NEO4J_USER=neo4j
SOULMATE_NEO4J_PASSWORD=soulemate_neo4j
